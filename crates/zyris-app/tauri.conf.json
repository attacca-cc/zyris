{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zyris",
  "version": "0.2.1",
  "identifier": "cc.attacca.zyris",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter zyris-ui dev",
    "beforeBuildCommand": "pnpm --filter zyris-ui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zyris",
        "theme": "Dark",
        "width": 1000,
        "height": 700,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "deb",
      "rpm",
      "nsis",
      "app",
      "dmg"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libpipewire-0.3-0",
          "libasound2",
          "libgbm1",
          "libayatana-appindicator3-1",
          "libvulkan1"
        ]
      },
      "rpm": {
        "depends": [
          "pipewire-libs",
          "alsa-lib",
          "mesa-libgbm",
          "libayatana-appindicator-gtk3",
          "vulkan-loader"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/icon.png",
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/64x64.png",
      "icons/32x32.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "android": {
      "minSdkVersion": 26
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFMjFDRDlENTQ5NDNFM0YKUldRL1BwUlVuYzBoYmtoV0RiQjFFUWxBQzFKZkFPd2ZwTm1Sbi9PS3o1RUZrRUE4NWRNTkhCY1UK",
      "endpoints": [
        "https://github.com/attacca-cc/zyris/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
